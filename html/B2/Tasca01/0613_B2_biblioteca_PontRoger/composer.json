{
    "name": "rogerpont/biblioteca-digital",
    "description": "Sistema de Gestió de Biblioteca Digital en PHP 8 a POO",
    "type": "project",
    "license": "MIT",
    "authors": [
        {
            "name": "Roger Pont",
            "email": "roger.pont.2173@lacetania.cat"
        }
    ],
    "require": {
        "php": ">=8.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "scripts": {
        "start": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:8000"
        ]
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true
    }
}
